<Page x:Class="Govno_2._0.View.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Govno_2._0.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="830" d:DesignWidth="1180"
      Title="ClientsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <ListBox Name="ClientsList" 
                 Background="Transparent" 
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Grid.RowSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="25" Height="50" Width="1150" Background="White" HorizontalAlignment="Center" Margin="3" BorderThickness="0.5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                               Text="{Binding Number}" 
                               FontSize="28" 
                               FontFamily="Times New Roman" 
                               FontWeight="Bold" 
                               Foreground="#F70129"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1" 
                               Text="{Binding FullName}" 
                               FontSize="24" 
                               FontFamily="Times New Roman" 
                               VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" 
                               Text="{Binding Phone}" 
                               FontSize="22" 
                               FontFamily="Times New Roman" 
                               Foreground="#555"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                            </Grid>

                            <Button Grid.Column="1"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="EditClientBtn_Click"
                        Tag="{Binding}">
                                <Image Source="/Resources/Edit.png" Height="25"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Name="HideAdd" Grid.Row="1" HorizontalAlignment="Right" Background="#F70129" 
                Width="140" Margin="0 25 0 0" CornerRadius="30 0 0 0" MouseEnter="HideAdd_MouseEnter"/>

        <Border Name="VisibleAdd" Grid.Row="1" HorizontalAlignment="Right" Background="#F70129" 
                Width="140" CornerRadius="30 0 0 0" Visibility="Hidden" MouseLeave="VisibleAdd_MouseLeave">

            <Button Name="AddClientBtn" Background="Transparent" Content="Добавить" 
                    FontSize="20" FontFamily="Times New Roman" BorderThickness="0" 
                    Foreground="White" FontWeight="Bold" Click="AddClientBtn_Click"/>
        </Border>
    </Grid>
</Page>